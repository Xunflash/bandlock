<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#111310</item>
        <item name="android:statusBarColor">#111310</item>
        <item name="android:navigationBarColor">#111310</item>
        <item name="android:colorAccent">#d7ff4a</item>
    </style>
    <style name="Btn">
        <item name="android:background">#d7ff4a</item>
        <item name="android:textColor">#14160f</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="BtnGhost" parent="Btn">
        <item name="android:background">#2a2e26</item>
        <item name="android:textColor">#f3f0e8</item>
    </style>
</resources>
